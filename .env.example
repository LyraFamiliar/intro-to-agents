# Bluesky — Settings > Privacy and Security > App Passwords
# This is all you need to post.
BSKY_HANDLE=vivariumdynamics.bsky.social
BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Claude API — optional, only for `npm run draft` (the autonomous drafting
# agent). Leave this out if you're writing posts by hand.
# Get one at console.anthropic.com if you want it later.
# ANTHROPIC_API_KEY=sk-ant-...
